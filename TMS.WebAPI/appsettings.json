{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/tms-log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=MINHAZ-NAAS\\SQLEXPRESS;Initial Catalog=TMS;Persist Security Info=True;User ID=sa;Password=sa1234;Encrypt=False;"
    //"DefaultConnection": "Data Source=DESKTOP-H6GCDP5\\SQLEXPRESS;Initial Catalog=TMS;Persist Security Info=True;User ID=sa;Password=1234;Encrypt=False;"
  },
  "Jwt": {
    "Key": "ThisIsASuperLongSecretKeyForJwtTokenGeneration1234567890",
    "Issuer": "TMS",
    "Audience": "TMSUsers"
  }
